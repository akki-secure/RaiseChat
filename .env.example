# ============================================================
# RaiseChat 環境変数テンプレート
# このファイルをコピーして .env を作成し、値を設定してください
# .env は絶対にコミットしないこと
# ============================================================

# Server
PORT=
NODE_ENV=

# Database
# アプリは最小権限の専用ユーザー（DB_USER）で接続する。SELECT/INSERT/UPDATE のみ・DELETE不可。DB_USER は raisechat_app 固定
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=raisechat_app
DB_PASSWORD=
# 管理用ユーザー: マイグレーション専用。アプリからは使わない（docker-compose が参照）
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# JWT
JWT_SECRET=

# CORS
CORS_ORIGIN=

# AWS S3 (ファイルアップロード)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Passkey (WebAuthn)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGIN=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
