# ============================================================
# RaiseChat 環境変数テンプレート
# このファイルをコピーして .env を作成し、値を設定してください
# .env は絶対にコミットしないこと
# ============================================================

# Server
PORT=
NODE_ENV=

# Database (アプリ専用ユーザー, rootは使用禁止)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=

# CORS
CORS_ORIGIN=

# AWS S3 (ファイルアップロード)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
